<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer draw their own splash screen: the SmartFlow mark on the brand navy.
         The icon must stay inside the middle 192dp circle of its 288dp canvas. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_animated</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/smartflow_splash_bg</item>
    </style>
</resources>