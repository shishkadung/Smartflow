# Android Keystore Configuration for Production Builds
# Copy this file to keystore.properties and fill in your actual values
# DO NOT commit the actual keystore.properties file to version control

# Path to your keystore file (relative to app directory or absolute path)
STORE_FILE=smartflow-release.jks

# Keystore password
STORE_PASSWORD=your_keystore_password_here

# Key alias
KEY_ALIAS=smartflow

# Key password
KEY_PASSWORD=your_key_password_here
