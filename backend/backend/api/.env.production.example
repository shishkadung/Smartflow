# SmartFlow API production template.
# Copy to ".env" ON THE SERVER, fill every value deliberately and keep it private. Never reuse the development
# .env and never commit this file after it holds real values.
#
# With APP_ENV=production, config.php (production-config-guard.php) answers "Server configuration is incomplete"
# until each setting below is safe: an explicit https CORS list, LOG_LEVEL info/warning/error, ALLOW_DEV_TOOLS
# off, and a database user that is not root with a non-empty password. The web server error log names the
# rejected settings (names only, never values).
#
# The loader reads "NAME=value" lines only. Do not put comments after a value on the same line.

APP_ENV=production
APP_TIMEZONE=Asia/Manila
ALLOW_DEV_TOOLS=false
LOG_LEVEL=warning

# Exact web origin(s), comma separated, https only, no trailing slash and no path.
CORS_ALLOWED_ORIGINS=https://smartflow.urbiztondo.gov.ph

# Dedicated least-privilege account. The runtime still checks and creates schema objects on startup, so it needs
# SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX and REFERENCES on this database only.
DB_HOST=localhost
DB_NAME=smartflow
DB_USER=
DB_PASS=

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=240

# Leave blank to let the API create its protected .qr-secret on first use. Keep that file and back it up:
# replacing it invalidates every printed folder label.
QR_SIGNING_SECRET=

# Recovery email. Gmail needs 2-Step Verification and a 16 character App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=SmartFlow
MAIL_FROM_ADDRESS=
MAIL_CA_BUNDLE=
