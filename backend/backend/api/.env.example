# SmartFlow Environment Configuration
# Copy this file to .env and update with your production values

# Database Configuration
DB_HOST=localhost
DB_NAME=smartflow
DB_USER=root
DB_PASS=

# Environment (development, production)
APP_ENV=development

# Timezone shared by PHP and MySQL (due dates, overdue alerts, scan session expiry)
APP_TIMEZONE=Asia/Manila

# Dev Tools (set to false in production)
ALLOW_DEV_TOOLS=false

# CORS (comma-separated allowed origins in production)
CORS_ALLOWED_ORIGINS=*

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=240

# Optional stable random QR signing secret (32+ bytes). If blank, a protected
# .qr-secret is generated securely; retain it across deployments.
QR_SIGNING_SECRET=

# Recovery email. Keep credentials in .env, never in PHP source.
# Option A - Gmail (or any SMTP server). Used whenever SMTP_HOST is set.
#   Gmail needs 2-Step Verification and a Google "App Password" (16 characters), not the normal Gmail password.
#   Port 587 with SMTP_SECURE=tls (STARTTLS) or port 465 with SMTP_SECURE=ssl. Plain SMTP is refused for real hosts.
#   The sender is the Gmail account; leave MAIL_FROM_ADDRESS empty to use it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=SmartFlow
# Option B - Mailtrap HTTP API (used only when SMTP_HOST is empty). A sandbox address never reaches real inboxes.
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAIL_FROM_ADDRESS=smartflow@urbiztondo.gov.ph
# Optional absolute CA bundle path if the PHP installation lacks trusted roots.
MAIL_CA_BUNDLE=

# JWT/Token Secret (generate a random string for production)
TOKEN_SECRET=change-this-to-random-secret-in-production

# Log Level (debug, info, warning, error)
LOG_LEVEL=debug
