# SmartFlow Environment Configuration
# Copy this file to .env and update with your production values

# Database Configuration
DB_HOST=localhost
DB_NAME=smartflow
DB_USER=root
DB_PASS=

# Environment (development, production)
APP_ENV=development

# Dev Tools (set to false in production)
ALLOW_DEV_TOOLS=true

# CORS (comma-separated allowed origins in production)
CORS_ALLOWED_ORIGINS=*

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# JWT/Token Secret (generate a random string for production)
TOKEN_SECRET=change-this-to-random-secret-in-production

# Log Level (debug, info, warning, error)
LOG_LEVEL=debug
